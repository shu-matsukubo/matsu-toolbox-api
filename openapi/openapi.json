{
  "openapi": "3.0.0",
  "info": {
    "version": "0.1.0",
    "title": "matsu Toolbox API",
    "description": "JWT-protected notes, bookmarks, and stateless text inspection."
  },
  "servers": [
    {
      "url": "http://localhost:18083",
      "description": "Local development"
    }
  ],
  "tags": [
    {
      "name": "System"
    },
    {
      "name": "Identity"
    },
    {
      "name": "Notes"
    },
    {
      "name": "Bookmarks"
    },
    {
      "name": "Tools"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "RS256 access token issued by matsu-auth for the matsu-toolbox-api audience."
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["ok"]
          }
        },
        "required": ["status"]
      },
      "MeResponse": {
        "type": "object",
        "properties": {
          "sub": {
            "type": "string",
            "minLength": 1
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "issuer": {
            "type": "string",
            "format": "uri"
          },
          "audience": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["sub", "issuer", "audience"]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "details": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            },
            "required": ["code", "message", "details"]
          }
        },
        "required": ["error"]
      },
      "ErrorDetail": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": ["path", "message"]
      },
      "Note": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "ownerSub": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "content": {
            "type": "string",
            "maxLength": 20000
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": ["id", "ownerSub", "title", "content", "createdAt", "updatedAt"]
      },
      "CreateNote": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "content": {
            "type": "string",
            "maxLength": 20000,
            "default": ""
          }
        },
        "required": ["title"]
      },
      "UpdateNote": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "content": {
            "type": "string",
            "maxLength": 20000
          }
        }
      },
      "Bookmark": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "ownerSub": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 50
            },
            "maxItems": 20
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": ["id", "ownerSub", "url", "title", "tags", "createdAt", "updatedAt"]
      },
      "CreateBookmark": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 50
            },
            "maxItems": 20,
            "default": []
          }
        },
        "required": ["url", "title"]
      },
      "UpdateBookmark": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 50
            },
            "maxItems": 20
          }
        }
      },
      "TextInspection": {
        "type": "object",
        "properties": {
          "codePointCount": {
            "type": "integer",
            "minimum": 0
          },
          "utf8ByteCount": {
            "type": "integer",
            "minimum": 0
          },
          "wordCount": {
            "type": "integer",
            "minimum": 0
          },
          "lineCount": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": ["codePointCount", "utf8ByteCount", "wordCount", "lineCount", "sha256"]
      },
      "InspectText": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 100000
          }
        },
        "required": ["text"]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "tags": ["System"],
        "responses": {
          "200": {
            "description": "The process is healthy.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/me": {
      "get": {
        "tags": ["Identity"],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Verified access-token identity.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "401": {
            "description": "Bearer access token is missing or invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Authentication keys are temporarily unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
